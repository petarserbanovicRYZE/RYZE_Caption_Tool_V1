{
  "manifestVersion": 5,
  "id": "com.ryze.captiontool.v1.uxp",
  "name": "RYZE Caption Tool",
  "version": "1.0.7",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.5.1"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "extensions": [
        ""
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ryze-captiontool-v1",
      "label": {
        "default": "RYZE Caption Tool"
      },
      "minimumSize": {
        "width": 360,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 480,
        "height": 600
      }
    }
  ]
}
