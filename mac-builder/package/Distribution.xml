<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>RYZE Caption Tool</title>
  <organization>com.ryze</organization>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <options customize="never" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
  <choices-outline>
    <line choice="ryze.captiontool.v1"/>
  </choices-outline>
  <choice id="ryze.captiontool.v1" visible="false" title="RYZE Caption Tool V1">
    <pkg-ref id="com.ryze.captiontool.v1.macos.pkg"/>
  </choice>
  <pkg-ref id="com.ryze.captiontool.v1.macos.pkg" version="__VERSION__" onConclusion="none">RYZE_Caption_Tool_Mac_Component.pkg</pkg-ref>
</installer-gui-script>
